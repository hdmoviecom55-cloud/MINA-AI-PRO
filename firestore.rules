rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPersonality(p) {
      return p in ['GIRLFRIEND', 'BEST_FRIEND', 'PROFESSIONAL', 'CARING', 'TEACHER', 'COACH'];
    }

    function isValidLanguage(l) {
      return l in ['HINGLISH', 'HINDI', 'ENGLISH'];
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('privateNote' in data) || (data.privateNote is string && data.privateNote.size() <= 1000)) &&
             (!('avatarUri' in data) || (data.avatarUri is string && data.avatarUri.size() <= 500)) &&
             (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 250)) &&
             (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 250)) &&
             (!('socialUrl' in data) || (data.socialUrl is string && data.socialUrl.size() <= 250)) &&
             (!('musicUrl' in data) || (data.musicUrl is string && data.musicUrl.size() <= 250)) &&
             isValidPersonality(data.personality) &&
             data.emotionLevel is int && data.emotionLevel >= 1 && data.emotionLevel <= 5 &&
             isValidLanguage(data.language);
    }

    function isValidMemoryItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             data.category in ['PREFERENCE', 'CONVERSATION', 'PERSONAL', 'GOAL'] &&
             data.encrypted is bool;
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.role in ['USER', 'MINA'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
             data.personality is string && data.personality.size() >= 1 && data.personality.size() <= 40;
    }

    function isValidJournalEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
             data.mood in ['HAPPY', 'CALM', 'EXCITED', 'TIRED', 'STRESSED', 'GRATEFUL'] &&
             data.encrypted is bool &&
             (!('aiReflection' in data) || (data.aiReflection is string && data.aiReflection.size() <= 2000));
    }

    function isValidSavedDocument(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.docType in ['RESUME', 'BIODATA', 'LETTER', 'CODE', 'NOTE'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 15000;
    }

    function isValidFavoritePlace(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.address is string && data.address.size() <= 300 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'personality', 'emotionLevel', 'language', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'bio', 'privateNote', 'avatarUri',
                         'youtubeUrl', 'instagramUrl', 'socialUrl', 'musicUrl',
                         'personality', 'emotionLevel', 'language', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'bio', 'privateNote', 'avatarUri',
                         'youtubeUrl', 'instagramUrl', 'socialUrl', 'musicUrl',
                         'personality', 'emotionLevel', 'language', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'encrypted', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'encrypted', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidMemoryItem(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'encrypted', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      match /chats/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'role', 'text', 'personality', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'text', 'personality', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChatMessage(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /journals/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'mood', 'encrypted', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'mood', 'encrypted', 'aiReflection', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'mood', 'encrypted', 'aiReflection', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /documents/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'docType', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'docType', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidSavedDocument(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(docId) &&
                         isValidSavedDocument(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'docType', 'content', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(docId);
      }

      match /places/{placeId} {
        allow get: if isOwner(userId) && isValidId(placeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(placeId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'address', 'latitude', 'longitude', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'address', 'latitude', 'longitude', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidFavoritePlace(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(placeId) &&
                         isValidFavoritePlace(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'latitude', 'longitude', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(placeId);
      }
    }
  }
}
